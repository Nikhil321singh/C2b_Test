# Backend API
VITE_REACT_APP_ENDPOINT=http://localhost:7002

# Local test convenience only.
# true  = KYC, IMEI verification and document uploads are optional.
# false = all configured production validations remain mandatory.
# Keep false in UAT and production.
VITE_RELAX_KYC_VALIDATION=false

# Local `npm run dev` only. Exercises required Aadhaar/IMEI UI with fixed test
# data and never calls the external providers. Ignored by production builds.
VITE_KYC_TEST_MODE=false

# Optional: prefill the customer payout form with HSBC's UAT payee VPA.
# Leave empty in production.
VITE_HSBC_UAT_TEST_VPA=
